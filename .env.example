NODE_ENV=development
DB_PASSWORD=replace-with-a-long-random-secret
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://ferie:ferie@localhost:5433/ferie
# Host port published by docker-compose.dev.yml; change it when another checkout already uses 5433.
DEV_DB_PORT=5433
AUTH_DISABLED=true
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ROLES_CLAIM=https://itatti.harvard.edu/roles
ED_BASE_URL=
ED_CLIENT_ID=
ED_CLIENT_SECRET=
ED_AUDIENCE=
# Development only: read a local Employee Directory that runs with its own auth escape hatch,
# instead of requesting an Auth0 machine-to-machine token. Refused when NODE_ENV=production.
ED_DEV_UNAUTHENTICATED=false
# Development only: grant STAFF_IT, FERIE_PORTAL_ADMIN, and FERIE_FINAL_APPROVER to these
# Employee Directory addresses on every sync, so a directory without application roles cannot
# lock administration out. Comma separated. Refused when NODE_ENV=production.
DEV_SUPERUSER_EMAILS=
AWS_REGION=eu-south-1
SES_FROM_EMAIL=
# Development only and mandatory as soon as SES_FROM_EMAIL is set outside production: every
# notification is delivered to this single mailbox and to nobody else. Refused in production.
MAIL_REDIRECT_TO=
APP_BASE_URL=http://localhost:5173
VITE_API_URL=/api
VITE_AUTH_DISABLED=true
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
